# crawler — copy to .env and fill in values
# env_prefix: CRAWLER_

# ── Supabase (required for Step 1 - reading articles) ─────────────────────────
CRAWLER_SUPABASE_URL=https://esctepjpgpjgrcymnabx.supabase.co
CRAWLER_SUPABASE_ANON_KEY=your-supabase-anon-key-here
CRAWLER_SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ── Optional settings ──────────────────────────────────────────────────────────
CRAWLER_POLL_INTERVAL_SECONDS=60
CRAWLER_ARTICLES_LIMIT=20
CRAWLER_ENABLE_SUMMARY=false
CRAWLER_AIHUB_URL=http://localhost:8001
CRAWLER_DEDUP_BACKEND=memory
CRAWLER_FACTOR_PUBLISH=true
