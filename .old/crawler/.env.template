# Crawler environment variables
# Copy this file to .env and fill in your values

GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here
ANALYSIS_URL=http://localhost:8000
ENABLE_ANALYSIS=false
ENABLE_SITEMAP_BACKFILL=true
SITEMAP_MAX_URLS_PER_SOURCE=120
# Max child sitemap XML files to open (newest lastmod first). 0 = no limit.
SITEMAP_MAX_SITEMAP_FILES=0
CRAWLER_SEEN_FILE=data/seen.json
CRAWLER_ARTICLES_FILE=data/articles.jsonl
CRAWLER_FEED_INCLUDE=
CRAWLER_FEED_EXCLUDE=

# Supabase storage (use project Settings → API; never commit real keys)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here
SUPABASE_TABLE=news_articles