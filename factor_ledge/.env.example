# factor_ledge — copy to .env and fill in values
# Run each service from its own directory: cd src/classify && node --loader ts-node/esm index.ts

# ── classify-service (port 3001) ──────────────────────────────────
CLASSIFY_PORT=3001
GROQ_API_KEY=[REDACTED_GROQ_TOKEN]

# "safe" = exact/cache only → LLM fallback per-factor (slower, more accurate)
# "fast" = keyword + fuzzy first, batch LLM only for unknowns
CLASSIFY_MODE=fast

# Delay (ms) between Groq batch calls to avoid rate-limit
GROQ_DELAY_MS=250

# ── ledger-service (port 3002) ────────────────────────────────────
LEDGER_PORT=3002
CLASSIFY_URL=http://localhost:3001

# ── query-service (port 3003) ─────────────────────────────────────
QUERY_PORT=3003
LEDGER_URL=http://localhost:3002
