# Copy to `.env` in this directory (Compose reads it automatically for `${VAR}` interpolation).
# Needed for UI + pipeline: Supabase tin tức; AIHub: ít nhất một LLM backend (Groq/OpenAI/Gemini).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional đọc bằng anon thay cho service role:
SUPABASE_ANON_KEY=
SUPABASE_TABLE=news_articles

# AIHub (trùng với crawler/Docker và aihub/src/config.py AIHUB_*)
AIHUB_LLM_BACKEND=groq
AIHUB_GROQ_API_KEY=
# Hoặc bật backend khác:
# AIHUB_LLM_BACKEND=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Dev: vite proxy forwards /api → main_controller (override nếu cần):
# MAIN_CONTROLLER_PUBLIC_URL=http://127.0.0.1:8005

# Dev: frontend market_data (docker-compose map cổng 8002 → host)
# VITE_MARKET_DATA_URL=http://localhost:8002
