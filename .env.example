# Copy to `.env` in this directory (Compose reads it automatically for `${VAR}` interpolation).
# Needed for UI + pipeline: Supabase tin tức; AIHub: ít nhất một LLM backend (Groq/OpenAI/Gemini).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional đọc bằng anon thay cho service role:
SUPABASE_ANON_KEY=
SUPABASE_TABLE=news_articles

# AIHub (trùng với crawler/Docker và aihub/src/config.py AIHUB_*)
# Example below matches the current evaluation setup:
# - provider: Groq
# - model: qwen/qwen3.6-27b
# - account limits mentioned: ~250K TPM / 1K RPM
AIHUB_LLM_BACKEND=groq
AIHUB_PREDICT_LLM_BACKEND=groq
AIHUB_GROQ_API_KEY=
AIHUB_GROQ_MODEL=qwen/qwen3.6-27b
# Nếu muốn model khác:
# AIHUB_GROQ_MODEL=llama-3.3-70b-versatile
# Hoặc bật backend khác:
# AIHUB_LLM_BACKEND=gemini
# AIHUB_GEMINI_API_KEY=
# AIHUB_GEMINI_MODEL=gemini-3.1-flash-lite
# OPENAI_API_KEY=

# AIHub post-rule tuning (sau LLM signal)
# AIHUB_POST_RULE_ENABLED=true
# AIHUB_POST_RULE_BULL_30D_PCT=10
# AIHUB_POST_RULE_BEAR_30D_PCT=-10
# AIHUB_POST_RULE_UP_3D_PCT=3
# AIHUB_POST_RULE_DOWN_3D_PCT=-3
# AIHUB_POST_RULE_MACD_CONFIRM_EPS=0
# AIHUB_POST_RULE_HOLD_OVERRIDE_MAX_CONF=0.72

# MAIN_CONTROLLER_K_SIMILAR=3
# MAIN_CONTROLLER_DB_URL=postgresql+asyncpg://postgres:pass@db:5432/postgres
# MAIN_CONTROLLER_JWT_SECRET=change-me
# MAIN_CONTROLLER_JWT_ACCESS_TTL_MINUTES=30
# MAIN_CONTROLLER_JWT_REFRESH_TTL_DAYS=14



# Dev: vite proxy forwards /api → main_controller (override nếu cần):
# MAIN_CONTROLLER_PUBLIC_URL=http://127.0.0.1:8005

# Dev: frontend market_data (docker-compose map cổng 8002 → host)
# VITE_MARKET_DATA_URL=http://localhost:8002

# MainController predictor switch: `aihub` (default) | `llm_gateway`
# MAIN_CONTROLLER_PREDICT_PROVIDER=llm_gateway
# MAIN_CONTROLLER_LLM_GATEWAY_URL=http://llm_gateway:8006
# MAIN_CONTROLLER_LLM_MIN_DIRECTIONAL_CONFIDENCE=0.56
# MAIN_CONTROLLER_LLM_HOLD_RELEASE_BIAS=2.2

# LLM Gateway (OpenCode Go, port 8006)
LLM_GATEWAY_OPENCODE_GO_API_KEY=
LLM_GATEWAY_DEFAULT_MODEL=deepseek-v4-flash
LLM_GATEWAY_FALLBACK_MODELS=qwen3.5-plus
LLM_GATEWAY_MAX_ATTEMPTS=1
LLM_GATEWAY_REQUEST_TIMEOUT_SECONDS=15
# DeepSeek V4 Pro often spends internal reasoning tokens before emitting JSON.
# LLM_GATEWAY_MAX_OUTPUT_TOKENS=800

# StockMem startup weights file (auto-load on service boot)
WEIGHTS_FILE=/app/stockmem/config/weights.auto.json

# StockMem auto Bayesian weight retraining (daily, UTC)
# Bật để service stockmem tự re-optimize weights theo lịch.
AUTO_OPTIMIZE_ENABLED=true
AUTO_OPTIMIZE_HOUR_UTC=1
AUTO_OPTIMIZE_MINUTE_UTC=15
AUTO_OPTIMIZE_HORIZON=7d
AUTO_OPTIMIZE_TRIALS=80
AUTO_OPTIMIZE_K=5
AUTO_OPTIMIZE_WARMUP=250
AUTO_OPTIMIZE_MIN_RECORDS=320
# Đường dẫn file snapshot weights trong container/workspace.
AUTO_OPTIMIZE_OUTPUT=/app/stockmem/config/weights.auto.json
