keywords = {Financial Domain,Opinion Mining,Question Answering},
publisher = {ACM},
title = {{Companion of the The Web Conference 2018 on The Web Conference 2018, {\{}WWW{\}} 2018, Lyon , France, April 23-27, 2018}},
url = {https://doi.org/10.1145/3184558. http://doi.acm.org/10.1145/3184558},
