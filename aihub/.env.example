AIHUB_LLM_BACKEND=gemini
AIHUB_GEMINI_API_KEY=your-gemini-api-key-here

AIHUB_OPENAI_API_KEY=your-openai-api-key-here

AIHUB_GROQ_API_KEY=your-groq-api-key-here
AIHUB_GROQ_MODEL=llama-3.3-70b-versatile

# Post-signal guardrails (override/tune LLM output)
AIHUB_POST_RULE_ENABLED=true
AIHUB_POST_RULE_BULL_30D_PCT=10
AIHUB_POST_RULE_BEAR_30D_PCT=-10
AIHUB_POST_RULE_UP_3D_PCT=3
AIHUB_POST_RULE_DOWN_3D_PCT=-3
AIHUB_POST_RULE_MACD_CONFIRM_EPS=0
AIHUB_POST_RULE_HOLD_OVERRIDE_MAX_CONF=0.72
