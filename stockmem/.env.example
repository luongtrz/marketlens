# StockMem service configuration
# Copy to .env and fill in values

# PostgreSQL connection string (required when running with Docker Compose)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DB_URL=postgresql+asyncpg://postgres:pass@localhost:5432/stockmem

# Vector backend: "memory" (FAISS in-memory, default) or "pgvector" (future)
VECTOR_BACKEND=memory

# Similarity search weights (must sum to 1.0)
# w1 = factor vector weight (semantic/event factors)
# w2 = indicator vector weight (RSI, MACD, SMA, fear_greed)
# w3 = price vector weight (OHLCV candle pattern)
W1_FACTOR=0.35
W2_INDICATOR=0.20
W3_PRICE=0.45
